{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TekBoard",
  "version": "0.7.0",
  "identifier": "dev.tekboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TekBoard",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560,
        "backgroundColor": "#141415"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "Organise tes projets Epitech",
    "longDescription": "Tekboard organise tes projets Epitech : dépôts, rendus, planning, logtime, tests, sujets de MY Epitech, et Artix, un assistant qui agit pour toi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Thibault Eininger",
    "homepage": "https://github.com/ar-oxyo/tekboard-desktop",
    "license": "GPL-3.0-only",
    "copyright": "© 2026 Thibault Eininger",
    "linux": {
      "deb": {
        "section": "education"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NjY2NDFDMTA2NTg5MEUKUldRT2lXVVFIR1JtaEsxeHpIWDB6aXp1MUhnUGZ6Q1hnam5IWHpERm9EQWgydElnRmJMV2tXaGIK",
      "endpoints": [
        "https://github.com/ar-oxyo/tekboard-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
