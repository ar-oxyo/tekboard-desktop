{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TekBoard",
  "version": "0.4.2",
  "identifier": "dev.tekboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TekBoard",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Development",
    "shortDescription": "Epitech developer command center",
    "longDescription": "Clone and initialise school projects in two clicks, keep an eye on every repository, manage project templates.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
