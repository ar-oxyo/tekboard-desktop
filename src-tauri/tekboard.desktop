[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
Actions=capture;
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}

[Desktop Action capture]
Name=Capture rapide
Name[en]=Quick capture
Exec={{exec}} capture
